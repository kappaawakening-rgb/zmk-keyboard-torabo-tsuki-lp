#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <input/processors/zmk-input-processor-keybind.dtsi>
#include <dt-bindings/zmk/input_transform.h>

/ {
    zip_tab_gesture: zip_tab_gesture {
        compatible = "zmk,input-processor-keybind";
        #input-processor-cells = <0>;
        mode = <1>;
        track_remainders;
        bindings =
            <&kp LC(TAB)>,
            <&kp LC(LS(TAB))>,
            <&kp LC(T)>,
            <&kp LC(W)>;
        tick = <80>;
        wait-ms = <0>;
        tap-ms = <10>;
    };

    zip_vdesk_gesture: zip_vdesk_gesture {
        compatible = "zmk,input-processor-keybind";
        #input-processor-cells = <0>;
        mode = <1>;
        track_remainders;
        bindings =
            <&kp LC(LG(RIGHT))>,
            <&kp LC(LG(LEFT))>,
            <&kp LC(LG(D))>,
            <&kp LC(LG(F4))>;
        tick = <80>;
        wait-ms = <0>;
        tap-ms = <10>;
    };
};

&pointing_listener {
    input-processors = <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
<&zip_temp_layer 8 10000>;

scroller {
	layers = <6>;
	input-processors = <&zip_xy_to_scroll_mapper>,
<&zip_scroll_transform (INPUT_TRANSFORM_X_INVERT)>,
<&zip_scroll_scaler 11 130>;
	process-next;
	};

tab_gesture {
	layers = <9>;
	input-processors = <&zip_tab_gesture>;
	};

vdesk_gesture {
	layers = <10>;
	input-processors = <&zip_vdesk_gesture>;
	};
};

&zip_temp_layer {
    require-prior-idle-ms = <150>;
    excluded-positions = <33 34 35>; // J K L
};

&size_s_transform {
    col-offset = <7>;
};

&size_m_transform {
    col-offset = <7>;
};

&size_l_transform {
    col-offset = <7>;
};
