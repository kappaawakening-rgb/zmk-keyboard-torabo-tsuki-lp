#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <25 26>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <13 14>;
        };

        Layer9 {
            bindings = <&mo 9>;
            key-positions = <35 36>;
            timeout-ms = <25>;
        };

        Layer10 {
            bindings = <&mo 10>;
            key-positions = <21 22>;
            timeout-ms = <25>;
        };

        Layer11 {
            bindings = <&mo 11>;
            key-positions = <49 50>;
        };
    };

    macros {
        bt0_to_win: bt0_to_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 0>;
        };

        bt1_to_win: bt1_to_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 0>;
        };

        bt2_to_win: bt2_to_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &to 0>;
        };

        bt3_to_mac: bt3_to_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &to 1>;
        };

        bt4_to_mac: bt4_to_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4 &to 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Win-Default_Layer {
            bindings = <
&trans  &trans            &trans          &trans    &trans        &trans                                        &trans              &trans  &trans     &trans      &trans     &trans
&trans  &kp Q             &kp W           &kp E     &kp R         &kp T                                         &kp Y               &kp U   &kp I      &kp O       &lt 6 P    &trans
&trans  &kp A             &kp S           &kp D     &kp F         &kp G             &trans         &trans       &kp H               &kp J   &kp K      &kp L       &kp MINUS  &trans
&trans  &mt LEFT_SHIFT Z  &kp X           &kp C     &kp V         &kp B             &kp BACKSPACE  &kp DELETE   &kp N               &kp M   &kp COMMA  &kp PERIOD  &kp SLASH  &trans
&trans  &kp LCTRL         &kp LEFT_SHIFT  &kp LALT  &kp LEFT_GUI  &lt 6 LANGUAGE_2  &lt 2 SPACE    &lt 6 SPACE  &lt 4 LANG_HANGEUL  &trans  &trans     &lt 7 HASH  &kp ENTER  &trans
            >;
        };

        Mac-Default_Layer {
            bindings = <
&trans  &trans            &trans          &trans            &trans        &trans                                        &trans              &trans  &trans     &trans      &trans     &trans
&trans  &kp Q             &kp W           &kp E             &kp R         &kp T                                         &kp Y               &kp U   &kp I      &kp O       &lt 6 P    &trans
&trans  &kp A             &kp S           &kp D             &kp F         &kp G             &trans         &trans       &kp H               &kp J   &kp K      &kp L       &kp MINUS  &trans
&trans  &mt LEFT_SHIFT Z  &kp X           &kp C             &kp V         &kp B             &kp BACKSPACE  &kp DELETE   &kp N               &kp M   &kp COMMA  &kp PERIOD  &kp FSLH   &trans
&trans  &kp LEFT_META     &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &lt 6 LANGUAGE_2  &lt 2 SPACE    &lt 6 SPACE  &lt 4 LANG_HANGEUL  &trans  &trans     &lt 7 HASH  &kp ENTER  &trans
            >;
        };

        Win-Function_Layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                       &trans                &trans                 &trans             &trans                &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans                       &kp LESS_THAN         &kp GREATER_THAN       &kp DOUBLE_QUOTES  &kp SEMICOLON         &kp AMPERSAND    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SQT            &kp COLON             &kp EXCLAMATION  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp AT_SIGN  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp COMMA          &kp PERIOD            &kp SLASH        &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans                &trans                 &trans             &kp NON_US_BACKSLASH  &kp DOLLAR       &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        Win-Common_Layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                         &trans         &trans              &trans          &trans               &trans         &trans
&trans  &trans  &trans  &trans  &trans  &kp LC(LG(T))                  &trans         &kp HOME            &trans          &kp END              &kp DEL        &trans
&trans  &trans  &trans  &trans  &trans  &kp PSCRN      &trans  &trans  &kp PG_UP      &kp LA(LEFT_ARROW)  &kp UP_ARROW    &kp LA(RIGHT_ARROW)  &kp BACKSPACE  &trans
&trans  &trans  &trans  &trans  &trans  &kp LG(LS(T))  &trans  &trans  &kp PAGE_DOWN  &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans         &trans  &trans  &trans         &trans              &trans          &trans               &trans         &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        Num_Layer {
            bindings = <
&trans  &trans   &trans   &trans  &trans          &trans                                   &trans      &trans  &trans  &trans        &trans         &trans
&trans  &kp F1   &kp F2   &kp F3  &kp F4          &kp F5                                   &kp N7      &kp N8  &kp N9  &kp SLASH     &kp DELETE     &trans
&trans  &kp F6   &kp F7   &kp F8  &kp F9          &kp F10         &trans           &trans  &kp N4      &kp N5  &kp N6  &kp ASTERISK  &kp BACKSPACE  &trans
&trans  &kp F11  &kp F12  &trans  &kp HOME        &kp UP_ARROW    &kp END          &kp N0  &kp N1      &kp N2  &kp N3  &kp MINUS     &kp PERCENT    &trans
&trans  &trans   &trans   &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &kp PERIOD  &trans  &trans  &kp PLUS      &kp EQUAL      &trans
            >;
        };

        Setting_Layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans       &trans       &trans       &trans       &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &bt0_to_win  &bt1_to_win  &bt2_to_win  &bt3_to_mac  &bt4_to_mac     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans       &trans       &trans       &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans  &to 0   &trans  &trans       &trans       &trans       &trans       &bt BT_CLR      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &to 1   &trans  &trans       &trans       &trans       &trans       &bt BT_CLR_ALL  &trans
            >;
        };

        Mouse_Layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans    &trans    &trans    &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans    &trans    &trans    &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB2  &mkp MB3  &kp LEFT_SHIFT  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB4  &trans    &mkp MB5  &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans          &trans
            >;
        };

        // Layer 9: ブラウザタブ切替ジェスチャ専用レイヤー
        // ボール操作: 左=前タブ 右=次タブ 上=新規タブ 下=最小化
        // 閉じる(Ctrl+W)は右親指キー(position 45)に割当
        // キーバインドはoverlay側のzip_tab_gestureで処理

        Tab_Gesture_Layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LC(W)  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // Layer 10: 仮想デスクトップ切替ジェスチャ専用レイヤー
        // ボール操作: 左=前デスク 右=次デスク 上=新規デスク 下=最小化
        // 閉じる(Ctrl+Win+F4)は右親指キー(position 45)に割当
        // キーバインドはoverlay側のzip_vdesk_gestureで処理

        VDesk_Gesture_Layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LC(LG(F4))  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        WinSnap_Gesture_Layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
